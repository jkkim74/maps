# Release signing configuration for the Android APK build.
#
# Copy this file to `keystore.properties` (same directory: apps/mobile/) and
# fill in the real values. `keystore.properties` and the keystore file itself
# (*.jks / *.keystore) are gitignored — NEVER commit real secrets.
#
# `storeFile` may be an ABSOLUTE path, or a path RELATIVE to apps/mobile/.
# The release signing block resolves relative paths against apps/mobile/.
#
# Generate a keystore with (see RELEASE.md for details):
#   keytool -genkeypair -v -keystore maps-release.jks \
#     -alias maps -keyalg RSA -keysize 2048 -validity 10000

storeFile=maps-release.jks
storePassword=CHANGE_ME_store_password
keyAlias=maps
keyPassword=CHANGE_ME_key_password
